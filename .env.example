# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Supabase (service key is SECRET — server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI providers (Groq is primary; Gemini/Together are fallbacks)
# GROQ_API_KEY is the single-key form and still works exactly as before.
GROQ_API_KEY=
# Optional: a comma-separated pool. Keys are tried round-robin, and a key that
# returns 429 is parked for whatever its reset header says (~1s for the TPM
# bucket, up to an hour for the daily one) while the request moves on to the
# next key — so a rate limit costs a key, not a user's reply. Keys from the SAME
# Groq account share one quota, so a pool only adds capacity across accounts.
# GROQ_API_KEYS=gsk_aaa...,gsk_bbb...,gsk_ccc...
GROQ_API_KEYS=
# Override the model without a deploy (paid-tier upgrade is an env change).
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Hidden "thinking" tokens on the failover path. 0 disables them — measured at
# 274 total tokens / 1.4s versus 640 / 5.9s with thinking on. Defaults to 0.
# GEMINI_THINKING_BUDGET=0
TOGETHER_API_KEY=

# Server
PORT=3000
NODE_ENV=development

# Dashboard
JWT_SECRET=
DASHBOARD_URL=http://localhost:3000

# Google sign-in (optional — button hidden when unset).
# Create at console.cloud.google.com → Credentials → OAuth client ID (Web).
# Redirect URI must be: {DASHBOARD_URL}/api/dashboard/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin alerts (your own Telegram chat id, for error DMs)
ADMIN_TELEGRAM_ID=

# Dev login for localhost testing (Telegram widget can't run on localhost).
# Leave unset/false on live servers — the app refuses to boot if this is
# true while NODE_ENV=production.
ENABLE_DEV_LOGIN=

# Cron
DAILY_TASK_TIME=8
WEEKLY_REVIEW_DAY=0
# Scheduled jobs run by default. Set to false on any EXTRA instance (e.g. a
# stray local server, or during a Render deploy overlap you want silenced) so
# only one instance fires daily tasks / check-ins / re-engagement DMs. Leave
# unset on your primary deploy — omitting it keeps crons ON.
# RUN_CRONS=false

# Payments (Dodo) — leave blank during the free beta; the bot runs fully without them.
# Set PAYMENTS_LAUNCHED=true ONLY once real payments are live. It flips one unsafe
# default: if the payments_enabled settings read fails, pre-launch we stay beta-
# generous (nothing to protect), post-launch we fail CLOSED so a transient DB error
# can't hand premium to everyone (BUG-005).
PAYMENTS_LAUNCHED=false
# Dodo webhook HMAC secret (Standard Webhooks; may be prefixed "whsec_").
DODO_WEBHOOK_SECRET=
# Bind grants to OUR product so a cheaper product carrying the same metadata can't
# unlock Pro. Optional, but recommended once more than one product exists.
DODO_PRODUCT_ID=
# Optional floor (smallest currency unit) below which a paid event is ignored.
# Leave unset until you've confirmed the real amount field on a live payment.
DODO_MIN_AMOUNT_CENTS=
